# Server-only environment. The application does NOT load any .env file itself.
# Supply this dedicated file through systemd EnvironmentFile; never use the root project .env.
MODEL_BASE_URL=https://your-compatible-provider.example/v1
MODEL_NAME=your-model-name
MODEL_API_KEY=replace-on-server
# Optional second model on the SAME server-fixed compatible endpoint.
# No client-provided model, endpoint or credentials are accepted.
LAB_ALTERNATE_MODEL_NAME=
# Shared site passphrase, supplied only through this service's EnvironmentFile.
# Every login has private records but all such logins share LAB_DAILY_RUNS.
LAB_ACCESS_PASSPHRASE=zhouxingfu
LAB_DATABASE=/var/lib/agent-game-lab/lab.sqlite3
LAB_DAILY_RUNS=10
LAB_MAX_STEPS=8
LAB_RUN_SECONDS=120
LAB_MAX_OUTPUT_TOKENS=512
LAB_TOKEN_DAYS=30
