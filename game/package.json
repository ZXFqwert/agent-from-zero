    "validate:content": "tsx scripts/validate-content.ts"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "lucide-react": "0.468.0"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  }
}
