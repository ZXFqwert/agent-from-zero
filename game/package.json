{
  "name": "echo-workshop",
  "version": "0.13.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4174",
    "build": "npm run validate:content && node scripts/build-graduation.mjs && tsc -b && vite build && node scripts/prepare-offline.mjs",
